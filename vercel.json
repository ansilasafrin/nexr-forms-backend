{
    "builds": [
        {
            "src": "app/main.py",
            "use": "@vercel/python",
            "config": {
                "maxDuration": 15,
                "memory": 512
            }
        }
    ],
    "routes": [
        {
            "src": "/uploads/(.*)",
            "headers": {
                "cache-control": "public, max-age=31536000, immutable"
            },
            "dest": "/uploads/$1"
        },
        {
            "src": "/(.*)",
            "dest": "app/main.py"
        }
    ]
}